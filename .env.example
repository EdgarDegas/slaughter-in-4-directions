# Optional overrides only. No .env is needed for the default setup.
# App defaults: app/constants.py. Docker bind/port defaults: compose.yaml.
# Copy this file to .env and uncomment only the settings you want to override.

# HOST_PORT=8080
# BIND_IP=0.0.0.0

# Optional shared key for this player, unrelated to an upstream account.
# When set, open /?key=YOUR_KEY. It also travels in HLS URLs for Apple TV.
# ACCESS_TOKEN=replace-with-your-private-key

# SMG_CHANNEL_ID=10
# SMG_API_VERSION=2.42.23
# SMG_DONOR_IDS=2218590,2215494,2215102,2213967
# SMG_SCAN_DAYS=7
# SMG_REQUEST_INTERVAL=0.5
# SMG_LOOKUP_TIMEOUT=180

# Empty uses the built-in CDN allowlist. Keep verified overrides local.
# UPSTREAM_HOSTS=
# Optional stream identifier to prevent channel mixups.
# SMG_EXPECTED_STREAM=
# Optional fixed 21-character anonymous browser ID (letters, digits, _ and -).
# SMG_UUID=
# Optional browser header shared by API and media requests.
# SMG_USER_AGENT=
